# ============================================================
# Imagine V2 — variáveis para Portainer (exemplo sem secrets)
# Copie para docker/.env.portainer (gitignored) e preencha.
# ============================================================

APP_HOST=imagine.papo.global

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=imagine
DATABASE_URL=postgres://postgres:changeme@postgres:5432/imagine

S3_BUCKET=imagine
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_ENDPOINT=https://s3.papo.global
S3_PUBLIC_URL=https://s3.papo.global

CLERK_SECRET_KEY=sk_test_your_clerk_secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_LLM_MODEL=anthropic/claude-opus-4.7
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-pro
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview

ELEVENLABS_API_KEY=
PEXELS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
