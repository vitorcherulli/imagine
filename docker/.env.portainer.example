# ============================================================
# Imagine V2 — variáveis para Portainer
# Copie para docker/.env.portainer (gitignored) se preferir env vars
# em vez de chaves inline no stack YAML.
# ============================================================

APP_HOST=imagine.papo.global

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=imagine
DATABASE_URL=postgres://postgres:changeme@postgres:5432/imagine

S3_BUCKET=imagine
S3_ACCESS_KEY=REDACTED_S3_ACCESS
S3_SECRET_KEY=REDACTED_S3_SECRET
S3_ENDPOINT=https://s3.papo.global
S3_PUBLIC_URL=https://s3.papo.global

CLERK_SECRET_KEY=sk_test_REDACTED_CLERK_SECRET
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REDACTED_CLERK_PUBLISHABLE

OPENROUTER_API_KEY=sk-or-v1-REDACTED_OPENROUTER_KEY
OPENROUTER_LLM_MODEL=anthropic/claude-opus-4.7
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-pro
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview

ELEVENLABS_API_KEY=
PEXELS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=YOUR_GOOGLE_CSE_ID
SERPER_API_KEY=
