# ============================================================
# Imagine V2 — variáveis para Portainer (copie para o stack)
# Copie para docker/.env.portainer (gitignored) e preencha os valores.
# ============================================================

# Domínio da aplicação (Traefik)
APP_HOST=imagine.papo.global

# PostgreSQL (stack postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=imagine
DATABASE_URL=postgres://postgres:changeme@postgres:5432/imagine

# MinIO console (opcional, stack minio)
MINIO_CONSOLE_HOST=minio.example.com
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# S3 / MinIO — credenciais da app
S3_BUCKET=imagine
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_ENDPOINT=https://s3.papo.global
S3_PUBLIC_URL=https://s3.papo.global

# Clerk
CLERK_SECRET_KEY=sk_test_your_clerk_secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_LLM_MODEL=anthropic/claude-opus-4.7
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-pro
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview

# ElevenLabs (optional — direct API for premium voices)
ELEVENLABS_API_KEY=

# Stock media (optional — image/video search in script & keyframe import)
PEXELS_API_KEY=

# Google Images — create engine at https://programmablesearchengine.google.com/
# 1. New search engine → Search the entire web
# 2. Control Panel → enable "Image search"
# 3. Copy Search engine ID → GOOGLE_CSE_ID
# 4. API key from Google Cloud Console (Custom Search API enabled)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=YOUR_GOOGLE_CSE_ID

# Google Images via Serper (recommended) — https://serper.dev/api-keys
SERPER_API_KEY=
