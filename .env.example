# ============================================================
# Imagine — environment variables (copy to .env.local)
#   cp .env.example .env.local
# Never commit .env.local — it is gitignored.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SQLite (dev) or Postgres URL (production)
DATABASE_URL=./data/app.db

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# OpenRouter — https://openrouter.ai/keys  (required for AI)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_LLM_MODEL=anthropic/claude-opus-4.7
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-pro
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3

# Optional — premium TTS / cloning
ELEVENLABS_API_KEY=

# Optional — stock image/video search
PEXELS_API_KEY=

# Optional — web / image research
SERPER_API_KEY=
TAVILY_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=
# Alias accepted by the app:
# GOOGLE_API_KEY=

# Optional — object storage (production / Portainer)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=imagine
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://s3.example.com

# Optional — path to ffmpeg if not on PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
